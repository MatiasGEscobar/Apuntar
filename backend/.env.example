# ===========================
# SERVIDOR
# ===========================
PORT=Puerto en el que ejecuta el servidor backend
NODE_ENV=Ambiente de ejecución (development, staging, production)

# ===========================
# BASE DE DATOS (PostgreSQL)
# ===========================
DATABASE_HOST=Host del servidor PostgreSQL
DATABASE_PORT=Puerto de conexión a PostgreSQL
DATABASE_USER=Usuario de acceso a la base de datos
DATABASE_PASSWORD=Contraseña del usuario de base de datos
DATABASE_NAME=Nombre de la base de datos
DATABASE_SSL=Habilitar SSL en conexión (true/false)

# ===========================
# FRONTEND
# ===========================
FRONTEND_URL=URL del frontend (usada para CORS y redirecciones)

# ===========================
# JWT
# ===========================
JWT_SECRET=Secreto para firmar tokens JWT (mínimo 32 caracteres)
JWT_EXPIRATION=Tiempo de expiración de tokens JWT (ej: 24h, 7d)

# ===========================
# GOOGLE OAUTH
# ===========================
GOOGLE_CLIENT_ID=ID de cliente OAuth de Google Cloud Console
GOOGLE_CLIENT_SECRET=Secreto de cliente OAuth de Google Cloud Console
GOOGLE_CALLBACK_URL=URL de redirección después de autenticación con Google

# ===========================
# CLOUDINARY
# ===========================
CLOUDINARY_NAME=Nombre de la nube en Cloudinary
CLOUDINARY_API_KEY=Clave API de Cloudinary
CLOUDINARY_API_SECRET=Secreto API de Cloudinary

# ===========================
# AWS S3
# ===========================
AWS_S3_REGION=Región de AWS donde está ubicado el bucket S3
AWS_S3_BUCKET=Nombre del bucket S3 para almacenar archivos
AWS_S3_ACCESS_KEY_ID=ID de clave de acceso AWS
AWS_S3_SECRET_ACCESS_KEY=Clave de acceso secreta AWS

# ===========================
# MERCADOPAGO
# ===========================
MERCADOPAGO_ACCESS_TOKEN=Token de acceso a la API de MercadoPago

# ===========================
# EMAIL (Nodemailer)
# ===========================
EMAIL_SERVICE=Servicio de email (ej: gmail, sendgrid, etc.)
EMAIL_USER=Email de la cuenta remitente
EMAIL_PASSWORD=Contraseña o clave de aplicación del email

# ===========================
# RENAR (si aplica)
# ===========================
RENAR_API_URL=URL base de la API de RENAR (registro de armas)
RENAR_API_KEY=Clave de acceso a la API de RENAR
